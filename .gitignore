# Publish only the reviewed research release; local originals stay in place.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/main.py
!/stock_predictor/
!/config/
!/tests/
!/scripts/
!/data/
!/results/
!/docs/

/stock_predictor/*
!/stock_predictor/*.py
/config/*
!/config/*.yaml
/tests/*
!/tests/test_strategy_significance_selection.py
/scripts/*
!/scripts/audit_release.py
/data/*
!/data/README.md
/results/*
!/results/README.md
!/results/main_results.csv
!/results/ablation.csv
!/results/ablation_significance.csv
!/results/reported_metrics.json
!/results/experiment_config.json
!/results/data_summary.json
!/results/leakage_audit.json
!/results/provenance.json
!/results/optimized_55_20seed_aggregate.csv
!/results/optimized_55_20seed_summary.csv
!/results/optimized_55_20seed_summary.json
!/results/optimized_55_20seed_config.json
!/results/optimized_55_20seed_README.md
/docs/*
!/docs/REPRODUCIBILITY.md
!/docs/RELEASE_REPORT.md

# Defense in depth, including nested files in allowed directories.
.env
*.env
.env.*
!.env.example
credentials*
secrets*
*.pem
*.key
*.p12
__pycache__/
*.py[cod]
.venv/
venv/
env/
.idea/
.vscode/
.claude/
.ipynb_checkpoints/
.pytest_cache/
cache/
cache_*/
logs/
*.log
tmp/
temp/
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.pkl
*.pickle
*.parquet
*.npy
*.npz
*.docx
*.pdf
*.zip
*.7z
*.bak
*.tmp
.DS_Store
Thumbs.db
